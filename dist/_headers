/*
  X-Content-Type-Options: nosniff
  # SAMEORIGIN 而非 DENY:custom app page(如 /posts/essay--gjj-2026-policy-briefing/)
  # 以同源 iframe 嵌 /policy/* 静态页,DENY 连自嵌都拒 → .org 白屏(pub-blogweb-appfix)。
  # SAMEORIGIN 仍拒绝一切跨站嵌入,防 clickjacking 效果不变。
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/feed.xml
  Content-Type: application/rss+xml; charset=utf-8

# pub-blogweb-imageopt P3:图片长缓存(.org Cloudflare Pages)。
# /notion/<uuid>/ 路径事实不可变 → 1y immutable;
# page-cover/ 为数据库封面,命名稳定但可换图 → 降为 1d(后规则覆盖先规则)。
/notion/*
  Cache-Control: public, max-age=31536000, immutable

/notion/page-cover/*
  Cache-Control: public, max-age=86400

# 节气背景 SVG,更新极少
/images/backgrounds/*
  Cache-Control: public, max-age=2592000
